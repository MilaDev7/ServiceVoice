NODE_ENV=development

PORT=5000

DATABASE_URL="postgresql://postgres:your_password@localhost:5432/woreda_navigator?schema=public"

FRONTEND_URL=http://localhost:5173

VOXIDE_API_KEY=
VOXIDE_API_URL=https://api.voxide.com

# Provider credentials stay on the backend and are never returned to clients.
LLM_API_KEY=
LLM_API_URL=
STT_API_KEY=
STT_API_URL=
TTS_API_KEY=
TTS_API_URL=

# Supported language identifiers: en, am, om, ti
DEFAULT_LANGUAGE=en
JWT_SECRET=replace-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=10
RAG_MIN_SCORE=0.05

# Local PostgreSQL + pgvector from docker-compose.yml
DATABASE_URL="postgresql://servicevoice:servicevoice_local_only@localhost:5432/servicevoice?schema=public"

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

CLOUDINARY_URL=